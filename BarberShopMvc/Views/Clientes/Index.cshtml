@model IEnumerable<BarberShopMvc.Models.Cliente>

@{
    ViewData["Title"] = "Lista de Clientes";
}

<div class="card-title">
    <h2>Lista de Pedidos</h2>
    <p>
        <a asp-action="Create" class="btn btn-outline-success">Novo Cliente</a>
    </p>
    <table>
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(Model => Model.Name)</>
                </th>
                <th>
                    @Html.DisplayNameFor(Model => Model.NumeroTelefone)</>
                </th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem =>item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NumeroTelefone)
                     </td>
                     <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Details" asp-route-id=@item.Id class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id=@item.Id class="btn btn-sm btn-danger">Delete</a>
                     </td>

                </tr>

            }
        </tbody>

    </table>



</div>
