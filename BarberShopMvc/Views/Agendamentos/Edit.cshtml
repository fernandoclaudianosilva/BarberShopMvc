@model BarberShopMvc.Models.ViewModels.AgendamentoFormViewModel

@{
    ViewData["Title"] = "Editar Agendamento";
}

<h2>@ViewData["Title"]</h2>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Agendamento.Id">
            <input type="hidden" asp-for="Agendamento.Id" />

            <div class="mb-3">
                <label asp-for="Agendamento.DataHora" class="control-label"></label>
                <input asp-for="Agendamento.DataHora" class="form-control" />
                <span asp-validation-for="Agendamento.DataHora" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Agendamento.ClienteId" class="control-label"></label>
                <select asp-for="Agendamento.ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
                <span asp-validation-for="Agendamento.ClienteId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Agendamento.ServicoId" class="control-label"></label>
                <select asp-for="Agendamento.ServicoId" class="form-control" asp-items="ViewBag.ServicoId"></select>
                <span asp-validation-for="Agendamento.ServicoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}